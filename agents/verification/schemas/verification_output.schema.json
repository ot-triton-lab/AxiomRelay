{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_schema_version",
    "verification_report",
    "verification_status",
    "verdict",
    "repair_hints",
    "needs_expanded_proofs",
    "checked_item_ids",
    "proof_digest",
    "context_digest"
  ],
  "properties": {
    "output_schema_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "verification_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "critical_errors",
        "gaps"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "critical_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "final",
        "needs_context"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "correct",
        "wrong"
      ]
    },
    "repair_hints": {
      "type": "string"
    },
    "needs_expanded_proofs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expansion_request"
      }
    },
    "checked_item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_digest": {
      "type": "string"
    },
    "context_digest": {
      "type": "string"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "issue"
      ],
      "properties": {
        "location": {
          "type": "string"
        },
        "issue": {
          "type": "string"
        }
      }
    },
    "expansion_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
